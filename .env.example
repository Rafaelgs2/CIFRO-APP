# Valores públicos do projeto Supabase. Copie para .env.local no desenvolvimento.
# A publishable key pode aparecer no navegador; nunca use uma secret/service-role key aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Usuário público do bot do Telegram, sem @. Monta o link de conexão no Perfil.
# O token do bot nunca entra aqui: ele fica só na credencial do n8n.
TELEGRAM_BOT_USERNAME=
